#!/usr/bin/env node
// Generated by keystone {{ generator_version }} (template v{{ template_version }}) at {{ generated_at }}.
//
// Deploy with:
//
//   npm install
//   npx cdk synth
//   npx cdk diff
//   npx cdk deploy --outputs-file cdk-outputs.json
//
// Then point the local Keystone profile at the deployed resources:
//
//   keystone infra cdk sync-profile --profile {{ profile_name }} --outputs ./cdk-outputs.json
import * as cdk from "aws-cdk-lib";
import { {{ stack_class }} } from "../lib/{{ stack_module }}";

const app = new cdk.App();

new {{ stack_class }}(app, {{ stack_name | json_encode }}, {
  // IAM Roles Anywhere trust anchors and profiles are regional, and the trust
  // anchor ARN is part of the role's trust policy, so the stack is pinned to the
  // Region the Keystone profile uses rather than taking the CLI default.
  env: {
    account: process.env.CDK_DEFAULT_ACCOUNT,
    region: {{ region | json_encode }},
  },
  trustAnchorName: {{ trust_anchor_name | json_encode }},
  profileName: {{ roles_anywhere_profile_name | json_encode }},
{%- if role_name %}
  roleName: {{ role_name | json_encode }},
{%- endif %}
  sessionDurationSeconds: {{ duration_seconds }},
  keystoneKeyId: {{ key_id | json_encode }},
  deviceSanUri: {{ device_san_uri | json_encode }},
{%- if existing_trust_anchor_arn %}
  existingTrustAnchorArn: {{ existing_trust_anchor_arn | json_encode }},
{%- endif %}
{%- if existing_role_arn %}
  existingRoleArn: {{ existing_role_arn | json_encode }},
{%- endif %}
});

app.synth();

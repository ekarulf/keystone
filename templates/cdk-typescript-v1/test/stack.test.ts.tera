// Generated by keystone {{ generator_version }} (template v{{ template_version }}) at {{ generated_at }}.
//
// These assertions run against the synthesized CloudFormation template, so they
// catch a broken stack before `cdk deploy` does — and, more importantly, they
// fail if an edit weakens the device restriction or attaches administrator
// permissions.
import * as cdk from "aws-cdk-lib";
import { Match, Template } from "aws-cdk-lib/assertions";
import { {{ stack_class }} } from "../lib/{{ stack_module }}";

const DEVICE_SAN_URI = {{ device_san_uri | json_encode }};
const DURATION_SECONDS = {{ duration_seconds }};

function synthesize(): Template {
  const app = new cdk.App();
  const stack = new {{ stack_class }}(app, {{ stack_name | json_encode }}, {
    env: { account: "123456789012", region: {{ region | json_encode }} },
    trustAnchorName: {{ trust_anchor_name | json_encode }},
    profileName: {{ roles_anywhere_profile_name | json_encode }},
{%- if not existing_role_arn %}
    roleName: {{ role_name | json_encode }},
{%- endif %}
    sessionDurationSeconds: DURATION_SECONDS,
    keystoneKeyId: {{ key_id | json_encode }},
    deviceSanUri: DEVICE_SAN_URI,
{%- if existing_trust_anchor_arn %}
    existingTrustAnchorArn: {{ existing_trust_anchor_arn | json_encode }},
{%- endif %}
{%- if existing_role_arn %}
    existingRoleArn: {{ existing_role_arn | json_encode }},
{%- endif %}
  });
  return Template.fromStack(stack);
}

{%- if existing_trust_anchor_arn %}
test("no trust anchor is created when an existing one is reused", () => {
  // Creating a second anchor for the same CA would widen what can assume the
  // role without anyone noticing.
  synthesize().resourceCountIs("AWS::RolesAnywhere::TrustAnchor", 0);
});
{%- else %}
test("exactly one trust anchor exists and it is enabled", () => {
  const template = synthesize();
  template.resourceCountIs("AWS::RolesAnywhere::TrustAnchor", 1);
  template.hasResourceProperties("AWS::RolesAnywhere::TrustAnchor", {
    Name: {{ trust_anchor_name | json_encode }},
    Enabled: true,
  });
});

test("the trust anchor carries the Keystone CA certificate", () => {
  // A trust anchor holding the wrong bundle would either reject this device or,
  // worse, accept certificates from a CA nobody intended to trust.
  synthesize().hasResourceProperties("AWS::RolesAnywhere::TrustAnchor", {
    Source: {
      SourceType: "CERTIFICATE_BUNDLE",
      SourceData: {
        X509CertificateData: Match.stringLikeRegexp(
          "-----BEGIN CERTIFICATE-----",
        ),
      },
    },
  });
});
{%- endif %}

test("exactly one Roles Anywhere profile exists with the configured duration", () => {
  const template = synthesize();
  template.resourceCountIs("AWS::RolesAnywhere::Profile", 1);
  template.hasResourceProperties("AWS::RolesAnywhere::Profile", {
    Name: {{ roles_anywhere_profile_name | json_encode }},
    Enabled: true,
    DurationSeconds: DURATION_SECONDS,
    AcceptRoleSessionName: true,
  });
});

test("the profile maps the certificate URI SAN into a session tag", () => {
  // Without this mapping the trust policy's `aws:PrincipalTag/x509SAN/URI`
  // condition has nothing to compare against, and the device restriction is
  // silently inert.
  synthesize().hasResourceProperties("AWS::RolesAnywhere::Profile", {
    AttributeMappings: Match.arrayWith([
      Match.objectLike({
        CertificateField: "x509SAN",
        MappingRules: Match.arrayWith([
          Match.objectLike({ Specifier: "URI" }),
        ]),
      }),
    ]),
  });
});

{%- if existing_role_arn %}
test("the externally managed role is referenced, not created", () => {
  const template = synthesize();
  template.resourceCountIs("AWS::IAM::Role", 0);
  template.hasResourceProperties("AWS::RolesAnywhere::Profile", {
    RoleArns: [{{ existing_role_arn | json_encode }}],
  });
});
{%- else %}
test("the profile references the role this stack creates", () => {
  synthesize().hasResourceProperties("AWS::RolesAnywhere::Profile", {
    RoleArns: [
      Match.objectLike({
        "Fn::GetAtt": Match.arrayWith([Match.stringLikeRegexp("KeystoneRole")]),
      }),
    ],
  });
});

test("the role trusts the Roles Anywhere service", () => {
  synthesize().hasResourceProperties("AWS::IAM::Role", {
    AssumeRolePolicyDocument: Match.objectLike({
      Statement: Match.arrayWith([
        Match.objectLike({
          Principal: {
            Service: "rolesanywhere.amazonaws.com",
          },
        }),
      ]),
    }),
  });
});

test("the role allows the session tagging Roles Anywhere performs", () => {
  // Regression test for a real deployment failure. `assumedBy` grants only
  // `sts:AssumeRole`, but the profile maps the certificate's URI SAN into a
  // session tag and accepts a role session name, so Roles Anywhere also calls
  // `sts:TagSession` and `sts:SetSourceIdentity`. Missing either produces
  // `AccessDenied` / "Unable to assume role" *after* the certificate and
  // signature have been accepted, which reads like a signing bug and is not one.
  const template = synthesize();
  for (const action of ["sts:TagSession", "sts:SetSourceIdentity"]) {
    template.hasResourceProperties("AWS::IAM::Role", {
      AssumeRolePolicyDocument: Match.objectLike({
        Statement: Match.arrayWith([
          Match.objectLike({
            Effect: "Allow",
            Action: Match.arrayWith([action]),
            Principal: {
              Service: "rolesanywhere.amazonaws.com",
            },
          }),
        ]),
      }),
    });
  }
});

test("the role trust policy is bound to this trust anchor and account", () => {
  // Without `aws:SourceArn` any trust anchor in the account could assume the
  // role, which would defeat per-device revocation.
  synthesize().hasResourceProperties("AWS::IAM::Role", {
    AssumeRolePolicyDocument: Match.objectLike({
      Statement: Match.arrayWith([
        Match.objectLike({
          Condition: Match.objectLike({
            ArnEquals: Match.objectLike({
              "aws:SourceArn": Match.anyValue(),
            }),
            StringEquals: Match.objectLike({
              "aws:SourceAccount": Match.anyValue(),
            }),
          }),
        }),
      ]),
    }),
  });
});

test("the role trust policy restricts assumption to this device", () => {
  synthesize().hasResourceProperties("AWS::IAM::Role", {
    AssumeRolePolicyDocument: Match.objectLike({
      Statement: Match.arrayWith([
        Match.objectLike({
          Effect: "Deny",
          Condition: Match.objectLike({
            StringNotEquals: Match.objectLike({
              "aws:PrincipalTag/x509SAN/URI": DEVICE_SAN_URI,
            }),
          }),
        }),
      ]),
    }),
  });
});

test("the role's maximum session duration matches the profile", () => {
  // A role that permits longer sessions than the profile requests leaves room
  // for a caller other than Keystone to obtain one.
  synthesize().hasResourceProperties("AWS::IAM::Role", {
    MaxSessionDuration: DURATION_SECONDS,
  });
});

test("no administrator policy is attached", () => {
  // The design's hard rule. This test is why the assertion is here rather than
  // in a review checklist: it fails on any future edit that reaches for
  // AdministratorAccess or a wildcard action.
  const rendered = JSON.stringify(synthesize().toJSON());
  expect(rendered).not.toContain("AdministratorAccess");
  expect(rendered).not.toContain("PowerUserAccess");
  expect(rendered).not.toContain('"Action":"*"');
  expect(rendered).not.toContain('"Action":["*"]');
});
{%- endif %}

test("the outputs Keystone needs are present", () => {
  // `keystone infra cdk sync-profile` reads these by name from
  // `cdk-outputs.json`; renaming one breaks the sync with a confusing error.
  // TrustAnchorArn, RolesAnywhereProfileArn and RoleArn are required; Region and
  // KeystoneKeyId are read when present (the key ID is what lets sync refuse
  // another device's outputs). DeviceSanUri is for the operator, not for sync.
  const outputs = synthesize().findOutputs("*");
  for (const name of [
    "TrustAnchorArn",
    "RolesAnywhereProfileArn",
    "RoleArn",
    "Region",
    "KeystoneKeyId",
    "DeviceSanUri",
  ]) {
    expect(Object.keys(outputs)).toContain(name);
  }
});

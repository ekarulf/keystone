{
  "name": {{ project_slug | json_encode }},
  "version": "0.1.0",
  "private": true,
  "bin": {
    {{ project_slug | json_encode }}: {{ bin_entry | json_encode }}
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.1000.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.173.0",
    "constructs": "^10.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  },
  "keystone": {
    "generatedBy": "keystone",
    "generatorVersion": {{ generator_version | json_encode }},
    "templateVersion": {{ template_version }},
    "generatedAt": {{ generated_at | json_encode }},
    "profile": {{ profile_name | json_encode }}
  }
}

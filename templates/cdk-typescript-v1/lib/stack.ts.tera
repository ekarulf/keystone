// Generated by keystone {{ generator_version }} (template v{{ template_version }}) at {{ generated_at }}.
//
// Regenerate with:
//
//   keystone infra cdk init --profile {{ profile_name }} --output . --force
//
// Edits made here are preserved: `keystone infra cdk init` refuses to overwrite a
// modified generated file without `--force`.
import * as fs from "node:fs";
import * as path from "node:path";
import { CfnOutput, Duration, Stack, StackProps } from "aws-cdk-lib";
import * as iam from "aws-cdk-lib/aws-iam";
import * as rolesanywhere from "aws-cdk-lib/aws-rolesanywhere";
import { Construct } from "constructs";

export interface {{ stack_class }}Props extends StackProps {
  /** Name for the IAM Roles Anywhere trust anchor. */
  readonly trustAnchorName: string;
  /** Name for the IAM Roles Anywhere profile. */
  readonly profileName: string;
{%- if not existing_role_arn %}
  /** Name for the IAM role Keystone assumes. */
  readonly roleName: string;
{%- endif %}
  /**
   * Maximum session length, in seconds.
   *
   * IAM Roles Anywhere caps a `CreateSession` duration at 3600 seconds, so this
   * is both the profile duration and the role's `maxSessionDuration`.
   */
  readonly sessionDurationSeconds: number;
  /** The Keystone key ID this stack authorizes. */
  readonly keystoneKeyId: string;
  /** The URI SAN carried by the device certificate: `urn:keystone:device:<key-id>`. */
  readonly deviceSanUri: string;
{%- if existing_trust_anchor_arn %}
  /** An existing trust anchor to reuse instead of creating one. */
  readonly existingTrustAnchorArn: string;
{%- endif %}
{%- if existing_role_arn %}
  /** An externally managed role. This stack does not modify it. */
  readonly existingRoleArn: string;
{%- endif %}
}

/**
 * Connects one Keystone device identity to IAM Roles Anywhere.
{%- if issuer_mode == "ephemeral-ca" %}
 *
 * The trust anchor holds the ephemeral CA certificate that signed this device's
 * certificate. That CA's private key was destroyed after issuing, so the anchor
 * can only ever vouch for this one device — which is what makes deleting or
 * disabling it a complete revocation.
{%- endif %}
 */
export class {{ stack_class }} extends Stack {
{%- if not existing_trust_anchor_arn %}
  public readonly trustAnchor: rolesanywhere.CfnTrustAnchor;
{%- endif %}
  public readonly rolesAnywhereProfile: rolesanywhere.CfnProfile;
{%- if not existing_role_arn %}
  public readonly role: iam.Role;
{%- endif %}

  constructor(scope: Construct, id: string, props: {{ stack_class }}Props) {
    super(scope, id, props);

{%- if existing_trust_anchor_arn %}
    // Existing trust anchor mode: the CA and its anchor are managed elsewhere.
    // This stack only needs the ARN, which appears in the role's trust policy.
    const trustAnchorArn = props.existingTrustAnchorArn;
{%- else %}
    // The CA certificate is public key material. It is read at synth time and
    // embedded in the template, so the deployed anchor does not depend on this
    // file still being present.
    const caCertificatePem = fs.readFileSync(
      path.join(__dirname, "..", "certificates", "keystone-ca.pem"),
      "utf8",
    );

    this.trustAnchor = new rolesanywhere.CfnTrustAnchor(this, "KeystoneTrustAnchor", {
      name: props.trustAnchorName,
      enabled: true,
      source: {
        sourceType: "CERTIFICATE_BUNDLE",
        sourceData: {
          x509CertificateData: caCertificatePem,
        },
      },
    });

    const trustAnchorArn = this.trustAnchor.attrTrustAnchorArn;
{%- endif %}

{%- if existing_role_arn %}
    // Existing role mode. This stack deliberately does not touch the role: it is
    // managed outside this project, and a CDK-owned change could remove trust
    // relationships this stack knows nothing about.
    //
    // Add the statement printed in README.md to the role's trust policy by hand
    // (or through whatever owns it) before running `keystone credential-process`.
    const roleArn = props.existingRoleArn;
{%- else %}
    // Roles Anywhere assumes the role on the caller's behalf. Both conditions
    // matter: `aws:SourceArn` binds the trust to this specific anchor, so another
    // trust anchor in the same account cannot assume this role, and
    // `aws:SourceAccount` prevents a cross-account confused deputy.
    const principal = new iam.ServicePrincipal("rolesanywhere.amazonaws.com", {
      conditions: {
        ArnEquals: {
          "aws:SourceArn": trustAnchorArn,
        },
        StringEquals: {
          "aws:SourceAccount": Stack.of(this).account,
        },
      },
    });

    this.role = new iam.Role(this, "KeystoneRole", {
      roleName: props.roleName,
      assumedBy: principal,
      description:
        "Assumed through IAM Roles Anywhere by the Keystone device " +
        props.keystoneKeyId,
      // A session cannot outlive this, so it bounds the blast radius of a leaked
      // session token independently of the profile's duration.
      maxSessionDuration: Duration.seconds(props.sessionDurationSeconds),
    });

    // `assumedBy` grants only `sts:AssumeRole`, which is not enough here.
    //
    // The profile below maps the certificate's URI SAN into a session tag, and
    // sets `acceptRoleSessionName`, so Roles Anywhere also calls `sts:TagSession`
    // and `sts:SetSourceIdentity` on this role. Without both, CreateSession fails
    // with `AccessDenied` and "Unable to assume role" — after the certificate and
    // signature have already been accepted, which makes it look like a signing
    // problem when it is not. The `Deny` below needs the same three actions, or a
    // caller with the wrong SAN would still be able to tag a session.
    this.role.assumeRolePolicy?.addStatements(
      new iam.PolicyStatement({
        effect: iam.Effect.ALLOW,
        principals: [principal],
        actions: ["sts:TagSession", "sts:SetSourceIdentity"],
      }),
    );

    // Restrict the role to this one device.
    //
    // The device's URI SAN reaches the trust policy as a session principal tag
    // produced by the profile's attribute mapping below. WARNING: the exact
    // condition key must match the mapping actually configured — verify with
    // `aws sts get-caller-identity` and CloudTrail after the first deploy, and
    // do not grant this role privileges you would not grant an unauthenticated
    // caller until you have confirmed the condition takes effect.
    this.role.assumeRolePolicy?.addStatements(
      new iam.PolicyStatement({
        effect: iam.Effect.DENY,
        principals: [new iam.AnyPrincipal()],
        actions: ["sts:AssumeRole", "sts:SetSourceIdentity", "sts:TagSession"],
        conditions: {
          StringNotEquals: {
            "aws:PrincipalTag/x509SAN/URI": props.deviceSanUri,
          },
        },
      }),
    );

{%- if permissions == "inline" %}
    // Inline policy from the file passed to `--policy`.
    this.role.attachInlinePolicy(
      new iam.Policy(this, "KeystoneInlinePolicy", {
        document: iam.PolicyDocument.fromJson(
          JSON.parse(
            fs.readFileSync(path.join(__dirname, "..", "policy", "inline-policy.json"), "utf8"),
          ),
        ),
      }),
    );
{%- elif permissions == "managed" %}
    // Managed policies from `--managed-policy-arn`.
{%- for arn in managed_policy_arns %}
    this.role.addManagedPolicy(
      iam.ManagedPolicy.fromManagedPolicyArn(this, "KeystoneManagedPolicy{{ loop.index0 }}", {{ arn | json_encode }}),
    );
{%- endfor %}
{%- else %}
    // No workload permissions. The role can be assumed and does nothing, which
    // is the right starting point: add only what this device needs.
    //
    //   this.role.addToPolicy(new iam.PolicyStatement({ ... }));
{%- endif %}
{%- endif %}

    this.rolesAnywhereProfile = new rolesanywhere.CfnProfile(
      this,
      "KeystoneRolesAnywhereProfile",
      {
        name: props.profileName,
        enabled: true,
        durationSeconds: props.sessionDurationSeconds,
        roleArns: [{% if existing_role_arn %}roleArn{% else %}this.role.roleArn{% endif %}],
        // Keystone sends `roleSessionName` so CloudTrail identifies the device.
        // Without this flag the name is dropped and Roles Anywhere substitutes a
        // hash of the certificate public key.
        acceptRoleSessionName: true,
        // Instance properties are for hosts enrolled through a Roles Anywhere
        // agent; a Mac signing with its own Secure Enclave has none.
        requireInstanceProperties: false,
        // Maps the certificate's URI SAN into a session principal tag, which is
        // what the trust policy condition above tests.
        attributeMappings: [
          {
            certificateField: "x509SAN",
            mappingRules: [
              {
                specifier: "URI",
              },
            ],
          },
        ],
      },
    );

{%- if not existing_trust_anchor_arn %}

    new CfnOutput(this, "TrustAnchorArn", {
      value: this.trustAnchor.attrTrustAnchorArn,
      description: "Pass to `keystone infra cdk sync-profile`.",
    });
{%- else %}

    new CfnOutput(this, "TrustAnchorArn", {
      value: trustAnchorArn,
      description: "The pre-existing trust anchor this profile uses.",
    });
{%- endif %}

    new CfnOutput(this, "RolesAnywhereProfileArn", {
      value: this.rolesAnywhereProfile.attrProfileArn,
    });

    new CfnOutput(this, "RoleArn", {
      value: {% if existing_role_arn %}roleArn{% else %}this.role.roleArn{% endif %},
    });

    new CfnOutput(this, "Region", {
      value: Stack.of(this).region,
    });

    new CfnOutput(this, "KeystoneKeyId", {
      value: props.keystoneKeyId,
    });

    new CfnOutput(this, "DeviceSanUri", {
      value: props.deviceSanUri,
    });
  }
}
